{
  "name": "xdc-desktop",
  "productName": "学习桌面",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build:native-glass": "dotnet publish ../prototypes/native-glass/NativeGlass.csproj -c Release -r win-x64 --self-contained false -p:PublishSingleFile=true -p:DebugType=embedded -o ./native-glass",
    "build:native-desktop": "dotnet publish ./native/NativeDesktop.csproj -c Release -r win-x64 --self-contained false -p:PublishSingleFile=true -p:DebugType=embedded -o ./native-bin",
    "start": "node ./start-native.mjs",
    "start:electron": "electron ."
  },
  "devDependencies": {
    "electron": "45.4.1"
  }
}
